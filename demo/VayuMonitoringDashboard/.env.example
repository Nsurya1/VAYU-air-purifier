# ==============================================================================
# SOCHI VAYU - Local Environment Configuration (.env.example)
# Copy to .env for local runtime usage.
# ==============================================================================

# Project & Network Binding (Binds strictly to localhost for security)
HOST_BIND_IP=127.0.0.1

# PostgreSQL Settings
# Note: Default mapped to 5434 to avoid collision with existing host Postgres on 5432/5433
POSTGRES_DB=vayu_monitoring
POSTGRES_USER=vayu_admin
POSTGRES_PASSWORD=vayu_dev_secret_2026
POSTGRES_PORT=5434

# Mosquitto MQTT Settings
MQTT_TCP_PORT=1883
MQTT_WS_PORT=9001

# Spring Boot Backend Settings
# Note: Default mapped to 8081 to avoid collision with host httpd on 8080
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# React Dashboard Settings
FRONTEND_PORT=3000
