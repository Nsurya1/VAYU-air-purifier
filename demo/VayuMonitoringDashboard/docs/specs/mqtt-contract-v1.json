{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VayuTelemetryPayloadV1",
  "type": "object",
  "required": [
    "schema_version",
    "device_id",
    "timestamp",
    "is_simulated",
    "metrics",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "is_simulated": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object",
      "required": ["fan_pct", "mode", "filter_hours_left", "rssi"],
      "properties": {
        "pm1": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 },
        "pm25": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 },
        "pm10": { "type": ["number", "null"], "minimum": 0, "maximum": 2000 },
        "voc": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 },
        "temp_c": { "type": ["number", "null"], "minimum": -20, "maximum": 80 },
        "rh": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "aqi": { "type": ["integer", "null"], "minimum": 0, "maximum": 500 },
        "aqi_standard": { "type": "string", "enum": ["US_EPA", "IN_CPCB"] },
        "fan_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "mode": { "type": "string", "enum": ["AUTO", "MANUAL", "NIGHT", "TURBO", "OFF", "ERROR_SAFE"] },
        "filter_hours_left": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "rssi": { "type": "integer", "minimum": -120, "maximum": 0 }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["fw_build_id", "uptime_seconds", "err_code", "sensor_status"],
      "properties": {
        "fw_build_id": { "type": "string" },
        "uptime_seconds": { "type": "integer", "minimum": 0 },
        "err_code": { "type": "integer" },
        "sensor_status": {
          "type": "object",
          "properties": {
            "pm_valid": { "type": "boolean" },
            "voc_valid": { "type": "boolean" },
            "temp_rh_valid": { "type": "boolean" }
          }
        }
      }
    }
  }
}
