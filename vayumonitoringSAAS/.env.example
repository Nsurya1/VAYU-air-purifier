# ==============================================================================
# SOCHI VAYU — Customer Installation Configuration Template
# ==============================================================================
# Rename this file to '.env' before running deploy.bat or deploy.sh.
# Customize these values for each specific customer premise installation.
# ==============================================================================

# Customer Facility & Site Identifier
CUSTOMER_SITE_NAME=SOCHI-HQ-BLDG1

# Network Port Bindings
# FRONTEND_PORT: Local web dashboard access port (accessible across customer LAN)
FRONTEND_PORT=3000

# MQTT_PORT: Purifier telemetry ingestion port (accessible across customer LAN)
MQTT_PORT=1883

# Freshness & Timeout Thresholds (in seconds)
# TELEMETRY_STALE_THRESHOLD_SECONDS: Marks device STALE if no packet arrives in this time
TELEMETRY_STALE_THRESHOLD_SECONDS=30

# TELEMETRY_OFFLINE_THRESHOLD_SECONDS: Marks device OFFLINE if no packet arrives in this time
TELEMETRY_OFFLINE_THRESHOLD_SECONDS=60

# Initial Fleet Device Provisioning (comma-separated stable IDs)
INITIAL_DEVICE_LIST=VAYU-001,VAYU-002,VAYU-003,VAYU-004,VAYU-005

# Internal Service MQTT Credentials (Change for production deployments)
MQTT_BACKEND_USERNAME=vayu_backend
MQTT_BACKEND_PASSWORD=VayuBackend2026!

MQTT_DEVICE_USERNAME=vayu_device
MQTT_DEVICE_PASSWORD=VayuDevice2026!

MQTT_SIMULATOR_USERNAME=vayu_simulator
MQTT_SIMULATOR_PASSWORD=VayuSim2026!
